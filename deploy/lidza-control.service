[Unit]
# lidza-control-boot-v1
Description=Lidza deployment control panel
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=0
[Service]
User=lidza-control
Group=lidza-control
SupplementaryGroups=docker
WorkingDirectory=/var/lib/lidza-control
Environment=LIDZA_TRUSTED_PROXIES=loopback
EnvironmentFile=/etc/lidza-control/control.env
ExecStart=/usr/local/bin/lidza-control
Restart=always
RestartSec=5
StateDirectory=lidza-control
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lidza-control
[Install]
WantedBy=multi-user.target
