{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://127.0.0.1:9090/tls/allow
	}
}

# Every configured application FQDN gets its own automatically renewed cert.
# DNS A/AAAA records must point here; ports 80 and 443 must be reachable.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8081
}

